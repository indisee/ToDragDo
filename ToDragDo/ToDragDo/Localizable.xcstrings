            "value" : "%1$lld–%2$lld of %3$lld"
          }
        }
      }
    },
    "%lld+" : {
      "comment" : "A label that appears in the checkout view when an item has more than two attachments, indicating how many more there are. The number inside the \"N+\" part is a count of additional attachments.",
      "isCommentAutoGenerated" : true
