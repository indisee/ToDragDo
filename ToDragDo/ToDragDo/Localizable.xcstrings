    "%lld" : {
      "comment" : "A badge displaying the number of items in a folder tab. The number is only shown when the tab is selected.",
      "isCommentAutoGenerated" : true
    },
    "%lld attachment%@" : {
      "comment" : "A label that announces the number of attachments. The value is dynamically set based on the number of attachments.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
