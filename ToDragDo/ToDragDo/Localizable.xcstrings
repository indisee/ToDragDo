          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld items in %2$@"
          }
        }
      }
    },
    "%lld items in %@ — click" : {
      "comment" : "A caption that appears in place of a list of items when the user has minimized the panel. The first argument is the count of items in the panel. The second argument is the name of the folder in which the items are listed.",
