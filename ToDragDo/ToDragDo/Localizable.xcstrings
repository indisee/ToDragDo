    "%lld–%lld of %lld" : {
      "comment" : "A label showing the current visible range of items and the total number of items. The first argument is the start of the current visible range. The second argument is the end of the current visible range. The third argument is the total number of items.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
