    "%lld items in %@" : {
      "comment" : "A caption that shows the number of items in a specific folder, followed by the name of that folder. The argument is the string “Today”, the string “Tomorrow”, the string “Limbo”, or the string “Done”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
